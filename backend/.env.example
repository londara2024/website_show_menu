# Copy to .env and fill in. .env is gitignored — never commit real values.

# Spring profile: set to prod on the server (application-prod.yml). Leave empty locally.
SPRING_PROFILES_ACTIVE=

# PostgreSQL password (used by the db and backend containers)
DB_PASSWORD=change-me

# JWT signing key, at least 32 characters:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars

# AES-256 key that encrypts personal data in the database (emails, names):  openssl rand -base64 32
# BACK IT UP somewhere safe. If it is lost, those columns can never be decrypted again.
DATA_ENCRYPTION_KEY=change-me-run-openssl-rand-base64-32

# How long a login lasts (Spring Duration: 8h, 30m, 7d)
JWT_TTL=8h

# First admin account, created on first start (an existing account is never changed)
ADMIN_EMAIL=admin@coffeeshop.local
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Admin

# Public URL of the website (CORS origin for the API)
PUBLIC_URL=http://localhost:3000

# Host ports (the website port is set in ../frontend)
BACKEND_PORT=8080
DB_PORT=5433

# API docs: Swagger UI at /swagger-ui.html, OpenAPI JSON at /v3/api-docs (set false in production if not needed)
SWAGGER_ENABLED=true
